{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git pull --rebase *)",
      "Bash(git add people/denis/data.json)",
      "Bash(git add people/alicja/data.json)",
      "Bash(git add people/denis/calisthenics_status.md)",
      "Bash(git add people/denis/training_block.md)",
      "Bash(git add people/denis/profile.md)",
      "Bash(git pull --rebase)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add .*)",
      "Bash(git add --all*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
